# Copy to .env only on a trusted machine. Never commit real values.
# v0.1 needs none of these to collect, calculate, or publish the local dashboard.

# Persistent public OCB agent seed (64 hex chars). GitHub Actions secret only.
# Never put this in a file that is committed, logged, or pasted into chat.
# TECHNOCORE_AGENT_SEED=

# Public posting is off unless this is exactly "true".
TECHNOCORE_PUBLISH=false

# Official FLOP testnet worker stays off until official software is reviewed.
FLOP_PARTICIPATION=false

# Computable GPU Index is CC BY-NC 4.0. Leave false unless noncommercial use is confirmed.
ENABLE_NONCOMMERCIAL_SOURCE=false
